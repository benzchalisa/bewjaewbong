# ============================================================
# .env.example — ไฟล์ตัวอย่างตัวแปรสภาพแวดล้อม (Environment Variables)
# วิธีใช้: ก๊อปปี้เป็น .env.local แล้วแก้ค่าตามเครื่องของคุณ
#   macOS/Linux :  cp .env.example .env.local
#   Windows     :  copy .env.example .env.local
# ============================================================

# ที่อยู่ของ Backend (Express) ที่เก็บข้อมูลหนังสือ
# - รันบนเครื่องตัวเอง (ไม่ใช้ Docker): http://localhost:3000
# - รัน Next.js ใน Docker แต่ Backend อยู่บนเครื่องหลัก: http://host.docker.internal:3000
# หมายเหตุ: ค่านี้ถูกอ่านฝั่งเซิร์ฟเวอร์ใน app/api/books/*.js
BACKEND_URL=http://localhost:3000
