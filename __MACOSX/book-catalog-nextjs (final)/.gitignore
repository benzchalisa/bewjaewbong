# ============================================================
# .gitignore — รายการไฟล์/โฟลเดอร์ที่ Git จะ "ไม่ติดตาม"
# ============================================================

# แพ็กเกจที่ npm install ลงมา (ใหญ่มาก และสร้างใหม่ได้เสมอจาก package.json)
node_modules

# ผลลัพธ์จากการ build / dev ของ Next.js (สร้างใหม่ได้)
.next
out

# ไฟล์ตั้งค่าลับ เช่น .env, .env.local (ห้าม commit เพราะอาจมีรหัสผ่าน)
.env*
# ยกเว้น .env.example เพราะเป็นไฟล์ตัวอย่างที่ควรแชร์ให้คนอื่นดู
!.env.example

# ไฟล์ขยะของ macOS
.DS_Store

# รูปที่ผู้ใช้อัปโหลด ไม่ต้องเก็บใน Git
public/uploads/*
# ...แต่เก็บ .gitkeep ไว้ เพื่อให้โฟลเดอร์ public/uploads ยังอยู่ใน repo
!public/uploads/.gitkeep
